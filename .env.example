# RecoverIQ Environment Configuration

# Demo & Execution Settings
DEMO_MODE=true
RECOVERY_EXECUTION_PROVIDER=simulation

# AI Engine Credentials (NVIDIA Nemotron or Gemini)
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Razorpay Test Mode Credentials (Optional for Demo Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Database & Task Queue (for production/backend setup)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoveriq
REDIS_URL=redis://localhost:6379/0

# Applet URL
APP_URL=
